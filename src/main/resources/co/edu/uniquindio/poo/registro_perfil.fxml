<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.viewController.RegistroPerfilViewController"
      spacing="20">

    <VBox styleClass="header">
        <Label fx:id="lblTitulo" styleClass="header-title"/>
    </VBox>

    <VBox alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
        <GridPane styleClass="card" hgap="14" vgap="14" maxWidth="620">

            <Label text="Identificación" GridPane.rowIndex="0"/>
            <TextField fx:id="txtIdentificacion"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0" prefWidth="340"/>

            <Label text="Nombre" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNombre"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>

            <Label fx:id="lblCodigo" text="Código"
                   GridPane.rowIndex="2"/>
            <TextField fx:id="txtCodigo"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"/>

            <Label fx:id="lblFecha" text="Fecha contrato"
                   GridPane.rowIndex="3"/>
            <DatePicker fx:id="dpFecha"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="3"/>

            <Label fx:id="lblSalario" text="Salario"
                   GridPane.rowIndex="4"/>
            <TextField fx:id="txtSalario"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="4"/>

            <Label fx:id="lblTipoCliente" text="Tipo cliente"
                   GridPane.rowIndex="5"/>
            <ComboBox fx:id="cbTipoCliente"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="5" prefWidth="220"/>

            <HBox spacing="10"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="6">
                <Button text="Guardar" onAction="#guardar"
                        styleClass="success-button"/>
                <Button text="Volver" onAction="#volver"
                        styleClass="secondary-button"/>
            </HBox>

        </GridPane>
    </VBox>

    <padding>
        <Insets bottom="26"/>
    </padding>
</VBox>
