<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.viewController.AdminMenuViewController"
      spacing="22">

    <VBox styleClass="header">
        <Label text="Panel de Administrador"
               styleClass="header-title"/>
        <Label fx:id="lblUsuario"
               styleClass="header-subtitle"/>
    </VBox>

    <VBox alignment="CENTER"
          VBox.vgrow="ALWAYS"
          spacing="18">

        <GridPane hgap="16"
                  vgap="16"
                  maxWidth="760">

            <Button text="Películas"
                    onAction="#peliculas"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.rowIndex="0"/>

            <Button text="Salas"
                    onAction="#salas"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0"/>

            <Button text="Funciones"
                    onAction="#funciones"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.rowIndex="1"/>

            <Button text="Tarifas"
                    onAction="#tarifas"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1"/>

            <Button text="Personal"
                    onAction="#personal"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.rowIndex="2"/>

            <Button text="Membresías"
                    onAction="#membresias"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="2"/>

            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

        </GridPane>

        <Button text="Volver al inicio"
                onAction="#inicio"
                styleClass="secondary-button"/>
    </VBox>

    <padding>
        <Insets bottom="26"/>
    </padding>
</VBox>
