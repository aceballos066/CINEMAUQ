<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.viewController.OperarioMenuViewController"
      spacing="22">

    <VBox styleClass="header">
        <Label text="Panel de Operario"
               styleClass="header-title"/>
        <Label fx:id="lblUsuario"
               styleClass="header-subtitle"/>
    </VBox>

    <VBox alignment="CENTER"
          VBox.vgrow="ALWAYS"
          spacing="18">

        <GridPane hgap="16"
                  vgap="16"
                  maxWidth="760">

            <Button text="Clientes y membresías"
                    onAction="#clientes"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.rowIndex="0"/>

            <Button text="Nueva venta"
                    onAction="#nuevaVenta"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0"/>

            <Button text="Consultar / cancelar ventas"
                    onAction="#ventas"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.rowIndex="1"/>

            <Button text="Disponibilidad"
                    onAction="#disponibilidad"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1"/>

            <Button text="Reportes"
                    onAction="#reportes"
                    styleClass="menu-button"
                    maxWidth="Infinity"
                    GridPane.columnSpan="2"
                    GridPane.rowIndex="2"/>

            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

        </GridPane>

        <Button text="Volver al inicio"
                onAction="#inicio"
                styleClass="secondary-button"/>

    </VBox>

    <padding>
        <Insets bottom="26"/>
    </padding>

</VBox>
